---
import { plans } from '../data/pricing';
---

<div class="plans">
  {plans.map((plan) => (
    <article class:list={['card', 'plan', { featured: plan.featured }]}>
      {plan.featured && <span class="plan-flag">Most popular</span>}
      <h3>{plan.name}</h3>
      <p class="plan-audience muted">{plan.audience}</p>
      <p class="plan-price">
        <span class="plan-amount">{plan.price}</span>
        <span class="plan-cadence">{plan.cadence}</span>
      </p>
      <p class="plan-annual muted">{plan.annual ?? 'Tailored to your portfolio'}</p>
      <ul class="check-list">
        {plan.features.map((f) => <li>{f}</li>)}
      </ul>
    </article>
  ))}
</div>

<style>
  .plans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: stretch;
  }

  @media (max-width: 900px) {
    .plans {
      grid-template-columns: 1fr;
      max-width: 460px;
      margin: 0 auto;
    }
  }

  .plan {
    position: relative;
    padding: 30px 28px 32px;
    display: flex;
    flex-direction: column;
    background: var(--surface-raised);
  }

  .plan.featured {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), var(--shadow);
  }

  .plan-flag {
    position: absolute;
    top: -12px;
    left: 28px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--marigold);
    color: var(--marigold-ink);
    padding: 4px 10px;
    border-radius: 100px;
  }

  .plan h3 {
    margin-bottom: 2px;
  }

  .plan-audience {
    font-size: 0.9rem;
    margin-bottom: 18px;
  }

  .plan-price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin: 0;
  }

  .plan-amount {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 2.6rem;
    line-height: 1;
    color: var(--ink);
  }

  .plan-cadence {
    color: var(--ink-muted);
    font-size: 0.95rem;
  }

  .plan-annual {
    font-size: 0.85rem;
    margin: 6px 0 22px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line-soft);
  }
</style>
