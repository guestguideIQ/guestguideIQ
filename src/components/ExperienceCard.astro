---
import type { Experience } from '../data/experiences';

interface Props {
  experience: Experience;
  showWhy?: boolean;
}

const { experience, showWhy = false } = Astro.props;
---

<article class="card experience-card">
  <div class="card-top">
    <span class="tag">{experience.destinationType}</span>
    <span class="location">{experience.location}</span>
  </div>
  <h3>{experience.title}</h3>
  <p class="blurb">{experience.blurb}</p>
  {showWhy && (
    <div class="why">
      <span class="why-label">Why it’s hyperlocal</span>
      <p>{experience.whyHyperlocal}</p>
    </div>
  )}
</article>

<style>
  .experience-card {
    padding: 24px 26px 26px;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface-raised);
  }

  .card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-bottom: 14px;
  }

  .tag {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-ink);
    background: var(--accent);
    padding: 4px 10px;
    border-radius: 100px;
  }

  .location {
    font-size: 0.82rem;
    color: var(--ink-faint);
  }

  .experience-card h3 {
    margin-bottom: 8px;
  }

  .blurb {
    font-size: 0.95rem;
    color: var(--ink-muted);
    flex: 1;
  }

  .why {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px dashed var(--line);
  }

  .why-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 6px;
  }

  .why p {
    font-size: 0.9rem;
    margin: 0;
  }
</style>
