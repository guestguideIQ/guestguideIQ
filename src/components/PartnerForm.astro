---
import { LEADS } from '../site.config';

interface Props {
  id?: string;
  defaultType?: string;
}

const { id = 'partner-form', defaultType } = Astro.props;

// `value`s are stored verbatim by the backend's lead-capture endpoint
// (organizationType is a free string there); keep existing values stable so
// earlier submissions stay comparable.
const orgTypes = [
  { value: 'str-operator', label: 'Host / co-host / property manager' },
  { value: 'pms-platform', label: 'PMS or hospitality software platform' },
  { value: 'experience-provider', label: 'Local business or experience provider' },
  { value: 'hardware', label: 'Smart-home or in-room hardware' },
  { value: 'hospitality', label: 'Boutique hotel or glamping operator' },
  { value: 'dmo', label: 'Destination / DMO' },
  { value: 'other', label: 'Other' },
];
---

<form
  action={LEADS.partner}
  method="POST"
  class="partner-form"
  id={id}
  data-ajax-form
  data-success-url="/thank-you/"
>
  <div class="field-row">
    <div class="field">
      <label for={`${id}-name`}>Name</label>
      <input id={`${id}-name`} type="text" name="name" required autocomplete="name" />
    </div>
    <div class="field">
      <label for={`${id}-company`}>Company / property</label>
      <input id={`${id}-company`} type="text" name="company" required autocomplete="organization" />
    </div>
  </div>

  <div class="field-row">
    <div class="field">
      <label for={`${id}-role`}>Role</label>
      <input
        id={`${id}-role`}
        type="text"
        name="role"
        required
        placeholder="e.g. Founder, Partnerships lead, Host"
      />
    </div>
    <div class="field">
      <label for={`${id}-type`}>I am a…</label>
      <select id={`${id}-type`} name="organizationType" required>
        <option value="" disabled selected={!defaultType}>
          Select one
        </option>
        {orgTypes.map((opt) => (
          <option value={opt.value} selected={defaultType === opt.value}>
            {opt.label}
          </option>
        ))}
      </select>
    </div>
  </div>

  <div class="field">
    <label for={`${id}-email`}>Email</label>
    <input id={`${id}-email`} type="email" name="email" required autocomplete="email" />
  </div>

  <div class="field">
    <label for={`${id}-message`}>Message</label>
    <textarea
      id={`${id}-message`}
      name="message"
      required
      placeholder="Tell us about your portfolio, your platform, or what you offer guests."
    ></textarea>
  </div>

  <button class="btn btn-primary" type="submit">
    Send Inquiry
  </button>
  <p class="form-note">We reply to every inquiry personally, usually within a couple of days.</p>
  <p class="form-error" data-form-error hidden>
    Something went wrong sending that. Please try again, or email us at hello@guestguideiq.com.
  </p>
</form>

<style>
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  @media (max-width: 560px) {
    .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>
