---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import GuidePhone from '../components/GuidePhone.astro';
import PricingCards from '../components/PricingCards.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import ConciergeChat from '../components/ConciergeChat.astro';
import { UPSELL_FEE } from '../data/pricing';
import { experiences } from '../data/experiences';

const gems = experiences.slice(0, 3);

const pillars = [
  {
    kicker: 'Instant import',
    title: 'Paste a link. Get a guide.',
    body: 'Drop in your Airbnb or Vrbo listing URL and GuestGuideIQ builds the foundation of your guidebook in seconds: house details, amenities, and a curated set of places nearby.',
  },
  {
    kicker: 'Always accurate',
    title: 'Recommendations that keep themselves current.',
    body: 'We re-check your local picks on a regular schedule, update opening hours, and flag venues that have closed, so a stale tip never costs you a five-star review.',
  },
  {
    kicker: 'Unmistakably yours',
    title: 'As considered as your interiors.',
    body: 'Your colors, your typography, and on larger plans, your own domain. Guests see your brand and never a template.',
  },
  {
    kicker: 'Earns its keep',
    title: 'A guidebook that pays you back.',
    body: 'Offer late check-outs, firewood bundles, mid-stay cleans and local tours right inside the guide. Your guidebook stops being a cost and starts bringing in revenue.',
  },
];
---

<BaseLayout title="GuestGuideIQ">
  <section class="hero wrap">
    <div class="hero-copy">
      <span class="eyebrow">The automated digital concierge</span>
      <h1>
        Your guidebook, <span class="accent-word">written</span> for you. And kept right.
      </h1>
      <p class="lead hero-sub">
        GuestGuideIQ turns your Airbnb or Vrbo listing into a beautiful, branded guest app in
        seconds, then quietly keeps every local recommendation up to date. You set it up once and we
        take care of the rest.
      </p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="#early-access">
          Get Early Access
        </a>
        <a class="btn btn-secondary" href="/how-it-works/">
          See how it works
        </a>
      </div>
      <p class="hero-note">Built for boutique hosts, co-hosts and property managers.</p>
    </div>
    <div class="hero-visual">
      <GuidePhone />
    </div>
  </section>

  <section class="problem band">
    <div class="wrap problem-inner">
      <div>
        <span class="eyebrow">The cold-start problem</span>
        <h2>Most guidebooks die in setup.</h2>
      </div>
      <div>
        <p class="lead">
          Fifty restaurant descriptions to write. Opening hours that change every season. The wine
          bar you loved that closed last spring. Hosts start digital guidebooks with good intentions
          and abandon them halfway, or worse, leave guests with a guide that’s quietly out of date.
        </p>
        <p class="lead">
          GuestGuideIQ does away with the blank page <em>and</em> with the upkeep.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <span class="eyebrow">Why hosts switch</span>
      <h2>
        Everything a great concierge does, <span class="accent-word">automated.</span>
      </h2>
    </div>
    <div class="pillars">
      {pillars.map((p, i) => (
        <article class="pillar">
          <span class="pillar-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="pillar-kicker">{p.kicker}</span>
          <h3>{p.title}</h3>
          <p class="muted">{p.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="hyperlocal">
    <div class="wrap section">
      <div class="hyperlocal-head">
        <div>
          <span class="eyebrow">Hyperlocal by design</span>
          <h2>
            Skip the tourist trail. <span class="accent-word">Share the good stuff.</span>
          </h2>
        </div>
        <p class="lead">
          Every “ten best things to do” list reads the same, because it’s built the same way:
          scraped, ranked and repeated. GuestGuideIQ curates by neighborhood, with the places a
          local would tell a friend about, matched to your exact address rather than the whole city.
        </p>
      </div>
      <div class="gem-grid">
        {gems.map((exp) => (
          <ExperienceCard experience={exp} />
        ))}
      </div>
      <a class="btn btn-secondary" href="/experiences/">
        See more hyperlocal picks
      </a>
    </div>
  </section>

  <section class="wrap section personal">
    <div class="personal-copy">
      <span class="eyebrow">Personal to every guest</span>
      <h2>No two stays get the same plan.</h2>
      <p class="lead">
        A couple on a wine weekend and a family with a toddler shouldn’t get the same list. Guests
        tell your concierge what they love and how much time they have, and it builds a personal
        itinerary from your guide’s local picks.
      </p>
      <ul class="check-list">
        <li>
          <strong>Grounded in your guide.</strong> Every suggestion comes from the places curated
          for your property, not the open internet.
        </li>
        <li>
          <strong>Honest when it’s thin.</strong> If an area has little curated content yet, the
          concierge says so instead of inventing places.
        </li>
        <li>
          <strong>Fewer questions for you.</strong> “Where should we eat tonight?” gets answered at
          midnight without waking you up.
        </li>
      </ul>
    </div>
    <div class="personal-visual">
      <ConciergeChat />
    </div>
  </section>

  <section class="wrap section-tight">
    <div class="card guest-card">
      <div class="guest-copy">
        <span class="eyebrow">For your guests</span>
        <h2>Nothing to download. Nothing to log in to.</h2>
        <p class="lead">
          Guests open one link and your guide installs to their home screen like an app, with Wi-Fi,
          check-in, house rules, local picks and your add-ons all in one place. It’s the first thing
          they open, not a binder they skip past.
        </p>
      </div>
      <ul class="check-list guest-list">
        <li>
          <strong>Works on any phone.</strong> An installable web app, no app store needed.
        </li>
        <li>
          <strong>A plan of their own.</strong> Itineraries built around each guest’s interests.
        </li>
        <li>
          <strong>Always current.</strong> Closed venues are flagged before a guest drives there.
        </li>
        <li>
          <strong>One-tap extras.</strong> Late check-out and other add-ons in a tap.
        </li>
      </ul>
    </div>
  </section>

  <section class="wrap section" id="pricing">
    <div class="section-head section-head-center">
      <span class="eyebrow">Pricing</span>
      <h2>Premium automation, priced for boutique portfolios.</h2>
      <p class="lead">
        Start with one property and grow into white-label. Guest upsells run on a simple{' '}
        {UPSELL_FEE} transaction fee, so there’s nothing extra to pay up front.
      </p>
    </div>
    <PricingCards />
    <p class="pricing-more">
      <a href="/pricing/">Compare plans and see how upsells work →</a>
    </p>
  </section>

  <section class="band early-access" id="early-access">
    <div class="wrap early-inner">
      <WaitlistForm id="waitlist-home" onDark />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    padding-top: clamp(48px, 8vw, 96px);
    padding-bottom: clamp(56px, 8vw, 104px);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }

  .hero-sub {
    margin-top: 12px;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 30px;
  }

  .hero-note {
    margin-top: 18px;
    font-size: 0.88rem;
    color: var(--ink-faint);
  }

  .hero-visual {
    position: relative;
  }

  .hero-visual::before {
    content: '';
    position: absolute;
    inset: 8% -4% 4% 8%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--marigold) 35%, transparent),
      transparent 70%
    );
    z-index: -1;
  }

  .problem {
    padding: clamp(56px, 8vw, 96px) 0;
  }

  .problem-inner {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(24px, 5vw, 64px);
  }

  @media (max-width: 760px) {
    .problem-inner {
      grid-template-columns: 1fr;
    }
  }

  .problem .eyebrow {
    color: var(--marigold);
  }

  .problem em {
    color: var(--band-ink);
    font-style: italic;
  }

  .section-head {
    max-width: 720px;
    margin-bottom: clamp(32px, 5vw, 48px);
  }

  .section-head-center {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .section-head-center .lead {
    margin: 0 auto;
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }

  @media (max-width: 1000px) {
    .pillars {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .pillars {
      grid-template-columns: 1fr;
    }
  }

  .pillar {
    border-top: 2px solid var(--ink);
    padding-top: 18px;
  }

  .pillar-num {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--accent);
    font-weight: 600;
  }

  .pillar-kicker {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 6px 0 10px;
  }

  .pillar h3 {
    font-size: 1.25rem;
  }

  .pillar p {
    font-size: 0.95rem;
  }

  .hyperlocal {
    background: var(--surface);
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
  }

  .hyperlocal-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(20px, 5vw, 64px);
    align-items: end;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  @media (max-width: 820px) {
    .hyperlocal-head {
      grid-template-columns: 1fr;
    }
  }

  .hyperlocal-head h2 {
    margin: 0;
  }

  .hyperlocal-head .lead {
    margin: 0;
  }

  .gem-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-bottom: 28px;
  }

  .personal {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }

  @media (max-width: 860px) {
    .personal {
      grid-template-columns: 1fr;
    }
  }

  .personal .check-list {
    margin-top: 22px;
  }

  .guest-card {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(24px, 5vw, 56px);
    padding: clamp(32px, 5vw, 56px);
    align-items: center;
  }

  @media (max-width: 820px) {
    .guest-card {
      grid-template-columns: 1fr;
    }
  }

  .pricing-more {
    text-align: center;
    margin: 28px auto 0;
    font-weight: 600;
  }

  .pricing-more a {
    text-decoration: none;
  }

  .early-access {
    padding: clamp(56px, 8vw, 96px) 0;
    margin-bottom: calc(-1 * clamp(48px, 8vw, 96px));
  }

  .early-inner {
    max-width: 720px;
    text-align: left;
  }
</style>
