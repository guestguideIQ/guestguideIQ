---
import BaseLayout from '../layouts/BaseLayout.astro';
import PartnerForm from '../components/PartnerForm.astro';

const partnerTypes = [
  {
    kicker: 'Property management platforms',
    title: 'Integrate with GuestGuideIQ',
    body: 'If you build a PMS, channel manager or pricing tool, a GuestGuideIQ integration lets your hosts turn every listing into an auto-updating guidebook without leaving your platform.',
    points: ['Listing and reservation sync', 'Marketplace and app-store listings', 'Co-marketing to shared customers'],
  },
  {
    kicker: 'Local businesses & experiences',
    title: 'Get recommended at the right moment',
    body: 'Tour operators, private chefs, rental companies and local favorites can reach guests inside the guide while they’re planning their day.',
    points: ['Featured placement in nearby guides', 'Bookable through the guest storefront', 'Affiliate and referral options'],
  },
  {
    kicker: 'Smart home & in-room hardware',
    title: 'Power the in-room screen',
    body: 'We’re speaking with smart-lock, hub and in-property tablet makers about bringing GuestGuideIQ to the devices guests find when they walk in.',
    points: ['Smart-lock code delivery', 'Smart-home hub sync', 'In-room display partnerships'],
  },
  {
    kicker: 'Boutique hotels & glamping',
    title: 'The same concierge, at a bigger scale',
    body: 'Local curation, a guest app that needs no download, and on-property upsells matter just as much to boutique hotels and luxury glamping sites. We’d like to hear from early design partners.',
    points: ['Multi-room and multi-site guides', 'Digital check-in on the roadmap', 'White-label on your domain'],
  },
];
---

<BaseLayout
  title="Partners"
  description="Partner with GuestGuideIQ: property management platforms, local businesses, smart-home hardware makers, and boutique hospitality operators."
>
  <section class="wrap section intro">
    <span class="eyebrow">Partner with GuestGuideIQ</span>
    <h1>Better guest experiences are a team effort.</h1>
    <p class="lead">
      GuestGuideIQ sits at the moment a guest decides what to do, what to book and how to get
      in. These are the partners we’re looking for to make that moment better.
    </p>
  </section>

  <section class="wrap section-tight partner-grid">
    {partnerTypes.map((p) => (
      <article class="card partner">
        <span class="eyebrow">{p.kicker}</span>
        <h2>{p.title}</h2>
        <p class="muted">{p.body}</p>
        <ul class="check-list">
          {p.points.map((pt) => <li>{pt}</li>)}
        </ul>
      </article>
    ))}
  </section>

  <section class="wrap section-tight" id="apply">
    <div class="card form-card">
      <h2>Start the conversation</h2>
      <p class="muted">One form, and it goes to the right person.</p>
      <PartnerForm id="partner-form-page" />
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 780px;
  }

  .partner-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  @media (max-width: 820px) {
    .partner-grid {
      grid-template-columns: 1fr;
    }
  }

  .partner {
    padding: clamp(26px, 4vw, 36px);
    background: var(--surface-raised);
  }

  .partner h2 {
    font-size: clamp(1.35rem, 2.4vw, 1.7rem);
  }

  .partner .check-list {
    margin-top: 18px;
  }

  .form-card {
    padding: clamp(28px, 5vw, 44px);
    max-width: 720px;
    margin: 0 auto;
    background: var(--surface-raised);
  }

  .form-card h2 {
    margin-bottom: 4px;
  }
</style>
