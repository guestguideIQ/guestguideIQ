---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, ANALYTICS } from '../site.config';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title === SITE.name ? title : `${title} · ${SITE.name}`;
const canonicalURL = new URL(Astro.url.pathname, SITE.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FBF3EA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1E1410" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonicalURL} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <!-- Square brand avatar from logo pack A1a. Swap for a 1200x630 og-image.jpg and
         "summary_large_image" once a wide social card is designed. -->
    <meta property="og:image" content={new URL('/brand/social-avatar-800.png', SITE.url)} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Instrument+Sans:wght@400;500;600&display=swap"
    />

    {ANALYTICS.plausibleDomain && (
      <script
        is:inline
        defer
        data-domain={ANALYTICS.plausibleDomain}
        src="https://plausible.io/js/script.js"
      ></script>
    )}
    {ANALYTICS.ga4MeasurementId && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.ga4MeasurementId}`}
        ></script>
        <script is:inline define:vars={{ id: ANALYTICS.ga4MeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          // gtag.js only recognises the Arguments object itself; a rest-parameter
          // array is silently ignored, so this must stay as Google ships it.
          function gtag() {
            // eslint-disable-next-line prefer-rest-params
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </>
    )}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      // Submit forms via fetch as JSON, matching the GuestGuideIQ backend's
      // lead-capture contract (REST/HTTP + JSON, see
      // aidlc/spaces/default/intents/260905-backend-services-spec/inception/contract-design/contract-summary.md,
      // Contract 3). Each form's field `name`s are written to match that
      // contract's request-body keys exactly, so a plain FormData -> object
      // conversion needs no per-form mapping. On success we redirect
      // ourselves to `/thank-you/` (or the form's `data-success-url`) rather
      // than relying on any server-side redirect.
      function bindAjaxForms() {
        document.querySelectorAll<HTMLFormElement>('form[data-ajax-form]').forEach((form) => {
          if (form.dataset.ajaxBound === 'true') return;
          form.dataset.ajaxBound = 'true';

          form.addEventListener('submit', async (event) => {
            event.preventDefault();
            if (!form.reportValidity()) return;

            const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
            const errorEl = form.querySelector<HTMLElement>('[data-form-error]');
            errorEl?.setAttribute('hidden', '');

            const originalLabel = submitBtn?.textContent ?? '';
            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.textContent = 'Sending…';
            }

            try {
              const payload: Record<string, string> = {};
              new FormData(form).forEach((value, key) => {
                if (typeof value === 'string') payload[key] = value;
              });

              const response = await fetch(form.action, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  Accept: 'application/json',
                },
                body: JSON.stringify(payload),
              });

              // Any non-2xx (validation error, backend outage, network
              // failure surfaced as a rejected fetch below) falls through to
              // the same generic, entered-data-preserving error message —
              // the contract explicitly doesn't require distinguishing them
              // client-side (see Contract 3's "On backend outage/network
              // failure" note).
              if (!response.ok) throw new Error(`Form submission failed (${response.status})`);

              window.location.assign(form.dataset.successUrl || '/thank-you/');
            } catch {
              errorEl?.removeAttribute('hidden');
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = originalLabel;
              }
            }
          });
        });
      }

      bindAjaxForms();
    </script>
  </body>
</html>
