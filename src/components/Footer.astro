---
import Logo from './Logo.astro';
import { SITE } from '../site.config';

const year = new Date().getFullYear();
---

<footer class="site-footer band">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <Logo height={32} variant="dark" />
      <p class="footer-tagline">
        {SITE.tagline} for boutique short-term rentals. Set it up once and leave it to us.
      </p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <div class="footer-col">
        <span class="footer-heading">Product</span>
        <a href="/how-it-works/">How It Works</a>
        <a href="/pricing/">Pricing</a>
        <a href="/pricing/#upsells">Guest Upsells</a>
      </div>
      <div class="footer-col">
        <span class="footer-heading">Company</span>
        <a href="/partners/">Partners</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
      </div>
      <div class="footer-col">
        <span class="footer-heading">Get in touch</span>
        <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
        <a href="/#early-access">Get early access</a>
      </div>
    </nav>
  </div>
  <div class="wrap footer-bottom">
    <span>© {year} GuestGuideIQ. All rights reserved.</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(48px, 8vw, 96px);
    border-top: 1px solid rgba(251, 243, 234, 0.1);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 40px;
    padding-top: clamp(48px, 7vw, 72px);
    padding-bottom: 36px;
  }

  .footer-tagline {
    margin-top: 16px;
    font-size: 0.92rem;
    max-width: 34ch;
    color: var(--band-muted);
  }

  .footer-nav {
    display: flex;
    gap: clamp(32px, 6vw, 64px);
    flex-wrap: wrap;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-heading {
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--marigold);
    margin-bottom: 2px;
  }

  .footer-col a {
    color: var(--band-muted);
    text-decoration: none;
    font-size: 0.92rem;
  }

  .footer-col a:hover {
    color: var(--band-ink);
  }

  .footer-bottom {
    border-top: 1px solid rgba(251, 243, 234, 0.12);
    padding-top: 18px;
    padding-bottom: 28px;
    font-size: 0.8rem;
    color: var(--band-muted);
  }
</style>
