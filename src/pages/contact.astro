---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import InvestorForm from '../components/InvestorForm.astro';
import { SITE } from '../site.config';
---

<BaseLayout
  title="Contact"
  description="Get in touch with GuestGuideIQ: request early access, partner with us, or reach out as an investor or member of the press."
>
  <section class="wrap section">
    <span class="eyebrow">Get in touch</span>
    <h1>Three quick ways to reach us.</h1>
    <p class="lead">
      Pick the one that fits, or email us directly at{' '}
      <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.
    </p>
  </section>

  <section class="wrap section-tight contact-grid">
    <div class="card contact-card">
      <span class="eyebrow">Hosts &amp; property managers</span>
      <h2>Get early access</h2>
      <p class="muted">
        We’re onboarding a small group of hosts first. Leave your email and we’ll send your
        invite and early-access pricing.
      </p>
      <WaitlistForm id="waitlist-contact" compact />
    </div>

    <div class="card contact-card">
      <span class="eyebrow">Platforms, businesses &amp; hardware</span>
      <h2>Partner with us</h2>
      <p class="muted">
        PMS platforms, local businesses, smart-home makers and boutique hotels can all use the
        partner form, and it reaches the right person.
      </p>
      <a class="btn btn-primary" href="/partners/#apply">Go to the partner form</a>
    </div>

    <div class="card contact-card contact-card-wide">
      <span class="eyebrow">Investor / press</span>
      <h2>Request more info</h2>
      <p class="muted">
        Want the fuller story or the roadmap, or have a question? Tell us a little about
        yourself below.
      </p>
      <InvestorForm id="investor-contact" />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  .contact-card {
    padding: clamp(24px, 4vw, 32px);
    background: var(--surface-raised);
  }

  .contact-card h2 {
    margin-top: 4px;
    margin-bottom: 6px;
  }

  .contact-card-wide {
    grid-column: 1 / -1;
  }
</style>
