---
import { LEADS } from '../site.config';

interface Props {
  id?: string;
  compact?: boolean;
  onDark?: boolean;
}

const { id = 'waitlist', compact = false, onDark = false } = Astro.props;
---

<div class:list={['waitlist-form', { compact, 'on-dark': onDark }]} id={id}>
  {!compact && (
    <>
      <h2>Claim your guide before we launch.</h2>
      <p class="lead">
        We’re opening GuestGuideIQ to a small group of hosts first. Leave your email and we’ll send
        your invite, along with early-access pricing.
      </p>
    </>
  )}
  <form
    action={LEADS.waitlist}
    method="POST"
    class="inline-form"
    data-ajax-form
    data-success-url="/thank-you/"
  >
    <label class="sr-only" for={`${id}-email`}>
      Email address
    </label>
    <input
      id={`${id}-email`}
      type="email"
      name="email"
      required
      placeholder="you@yourproperty.com"
      autocomplete="email"
    />
    <button class="btn btn-primary" type="submit">
      Get Early Access
    </button>
  </form>
  <p class="form-note">
    We’ll only email you about your GuestGuideIQ invite. No spam, unsubscribe anytime.
  </p>
  <p class="form-error" data-form-error hidden>
    Something went wrong sending that. Please try again, or email us at hello@guestguideiq.com.
  </p>
</div>

<style>
  .waitlist-form h2 {
    margin-bottom: 10px;
  }

  .inline-form {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }

  .compact .inline-form {
    margin-top: 0;
  }

  .inline-form input[type='email'] {
    flex: 1 1 240px;
    min-width: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 12px 18px;
    border-radius: 100px;
    border: 1px solid var(--line);
    background: var(--surface-raised);
    color: var(--ink);
  }

  .on-dark h2 {
    color: var(--band-ink);
  }

  .on-dark .lead,
  .on-dark .form-note {
    color: var(--band-muted);
  }

  .on-dark .inline-form input[type='email'] {
    background: rgba(251, 243, 234, 0.08);
    border-color: rgba(251, 243, 234, 0.22);
    color: var(--band-ink);
  }

  .on-dark .inline-form input[type='email']::placeholder {
    color: var(--band-muted);
  }

  .on-dark .btn-primary {
    background: var(--marigold);
    color: var(--marigold-ink);
  }

  .on-dark .btn-primary:hover {
    background: #f6c567;
  }

  .on-dark .form-error {
    color: #ef8d73;
  }
</style>
